{
  "name": "@manuelfedele/postino",
  "version": "0.4.3",
  "description": "Inter-agent messaging and broadcast system for Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "postino": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/web/public dist/web/",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "hooks",
    "commands",
    ".claude-plugin",
    ".mcp.json"
  ],
  "keywords": [
    "claude",
    "mcp",
    "messaging",
    "valkey",
    "broadcast",
    "multi-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/manuelfedele/postino"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.13",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
